{
  "manifest_version": 3,
  "name": "1일1코 - 하루에 알고리즘 하나",
  "short_name": "1일1코",
  "version": "1.2.0",
  "description": "프로그래머스 코딩테스트 문제를 매일 하나씩 알림으로 추천하고, 제출 결과를 자동 감지해 복습·약점 분석까지 해 줍니다. (비공식)",
  "homepage_url": "https://github.com/gggeunyoung/programmers-daily",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://school.programmers.co.kr/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "1일1코",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://school.programmers.co.kr/*"],
      "js": ["src/content/programmers.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
